{
  "expo": {
    "name": "Diário de Leitura",
    "slug": "diario-leitura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diarioleitura",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.folio.diariodeleitura"
    },
    "android": {
      "package": "com.folio.diariodeleitura",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para personalizar seu perfil e as capas dos livros.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69ec23fb-8ad1-4777-9b8a-89f44d9cc7fb"
      }
    }
  }
}
